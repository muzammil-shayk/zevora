# ZEVORA Jewellery — Production & Payment Gateway Configuration
# Copy to .env.local for local overrides, or set in Vercel → Project Settings → Environment Variables.

# Public storefront URL (set to https://zevorastores.com in Vercel Production)
NEXT_PUBLIC_SITE_URL=https://zevorastores.com

# Official contact email
ZEVORA_SUPPORT_EMAIL=info@zevorastores.com

# Active card gateway mode: "sandbox" (default testing) or "stripe" (live card payments)
PAYMENT_GATEWAY_MODE=sandbox

# Stripe API credentials (required when PAYMENT_GATEWAY_MODE=stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Bank Transfer instructions displayed at checkout
ZEVORA_BANK_NAME=ZEVORA Luxury Commerce Bank
ZEVORA_BANK_ACCOUNT_TITLE=ZEVORA Jewellery Studio
ZEVORA_BANK_IBAN=PK00ZEVR0000001234567890

# Optional Vercel Cloud Persistence (1-click Upstash Redis integration in Vercel Storage)
# When configured, orders, inquiries, and subscribers persist permanently across serverless functions.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
