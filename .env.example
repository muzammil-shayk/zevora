# ZEVORA Jewellery — Pakistan (PKR) COD & Email Notification Configuration
# Copy to .env.local for local testing, or paste into Vercel → Project Settings → Environment Variables.

# Public storefront URL
NEXT_PUBLIC_SITE_URL=https://zevorastores.com

# Where every new COD order shipping sheet & stylist inquiry is emailed
ORDER_NOTIFICATION_EMAIL=info@zevorastores.com

# ==============================================================================
# EMAIL DELIVERY — Option A: Hostinger Business Email SMTP (Recommended — Free!)
# Uses your existing info@zevorastores.com mailbox directly.
# ==============================================================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@zevorastores.com
SMTP_PASS=your_hostinger_email_password_here
SMTP_FROM=info@zevorastores.com

# ==============================================================================
# EMAIL DELIVERY — Option B: Resend API (Alternative if you prefer Resend)
# ==============================================================================
RESEND_API_KEY=

# ==============================================================================
# OPTIONAL: Vercel Cloud Order Storage (1-click Upstash Redis in Vercel Storage)
# ==============================================================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
